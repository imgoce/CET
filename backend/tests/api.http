### =====================================================================
### CET 백엔드 API 테스트 (VS Code 확장: REST Client by Huachao Mao)
###
### 준비
###   1. 같은 폴더의 .env.example 을 복사해 .env 를 만들고 URL·키를 채운다
###   2. 각 요청 위의 "Send Request"를 위에서부터 순서대로 누른다
###
### 참고
###   - 익명 로그인(1번, 14-1번)을 누를 때마다 새 사용자가 생긴다.
###     기본 제한은 IP당 시간당 30회. 테스트 사용자는
###     대시보드 Authentication → Users 에서 지우면 관련 데이터도 같이 지워진다.
###   - 실패 응답은 { "code": "PTxxx", "message": "오류 키", "details": "설명" } 형식이다.
###     "기대 결과"와 다르면 message 를 확인한다.
### =====================================================================

@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_PUBLISHABLE_KEY}}

@token = {{signup.response.body.$.access_token}}
@token2 = {{signup2.response.body.$.access_token}}


### ---------------------------------------------------------------------
### [정상 흐름]
### ---------------------------------------------------------------------

### 1. 익명 로그인 (앱 첫 실행)
# 기대: 200, access_token 과 user.is_anonymous = true
# @name signup
POST {{url}}/auth/v1/signup
apikey: {{key}}
Content-Type: application/json

{}


### 2. 내 정보 (닉네임 등록 전)
# 기대: 200, [] → 앱은 닉네임 화면으로 이동
POST {{url}}/rest/v1/rpc/get_my_profile
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}


### 3. 닉네임 사용 가능 여부 (US-1-1)
# 기대: 200, true
POST {{url}}/rest/v1/rpc/is_nickname_available
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_nickname": "없는닉네임" }


### 4. 닉네임 등록 + 펫 생성 (US-1, US-1-3)
# 기대: 200, level 1 / stage "egg" / food 0
# 실행할 때마다 무작위 닉네임(test0000~test9999)을 쓴다
# @name register
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_nickname": "test{{$randomInt 1000 9999}}" }


### 5. 내 정보 (닉네임 등록 후, US-2-1)
# 기대: 200, [{ nickname, level 1, stage "egg", food 0 }]
# @name profile
POST {{url}}/rest/v1/rpc/get_my_profile
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}


### 6. 수집 기록 저장 - 테스트 모드 (DC-6, DC-7)
# 기대: 200, record 에 새 id 와 is_test = true, rewards [] (테스트 모드는 보상 없음)
# @name collect
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 07",
  "p_temperature": 21.5,
  "p_humidity": 55.0,
  "p_aqi": 1,
  "p_tvoc": 100,
  "p_co2": 650,
  "p_rssi": -70,
  "p_measured_at": "{{$datetime iso8601}}",
  "p_public_server_id": "test-{{$guid}}",
  "p_is_shadow_area": false,
  "p_is_test": true
}


### 7. 같은 수집 기록 재전송 (중복 저장 방지)
# 기대: 200, record.id 가 6번과 같음 (새 기록이 생기지 않음)
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 07",
  "p_temperature": 21.5,
  "p_humidity": 55.0,
  "p_aqi": 1,
  "p_tvoc": 100,
  "p_co2": 650,
  "p_rssi": -70,
  "p_measured_at": "{{collect.response.body.$.record.measured_at}}",
  "p_public_server_id": "{{collect.response.body.$.record.public_server_id}}",
  "p_is_shadow_area": false,
  "p_is_test": true
}


### 8. 내 수집 기록 조회
# 기대: 200, 6번에서 저장한 기록 1건만 보임
GET {{url}}/rest/v1/collection_records?select=id,sensor_name,temperature,public_server_id,is_test&order=id.desc
apikey: {{key}}
Authorization: Bearer {{token}}


### 9. 랭킹 (RK-1)
# 기대: 200, rank / nickname / level / stage / is_me. UUID 는 없어야 함
POST {{url}}/rest/v1/rpc/get_ranking
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_limit": 50 }


### ---------------------------------------------------------------------
### [보안·예외] 모두 "실패해야 정상"
### ---------------------------------------------------------------------

### 10. 세션 없이 함수 호출
# 기대: 401, permission denied (로그인 안 한 요청은 거절)
POST {{url}}/rest/v1/rpc/get_my_profile
apikey: {{key}}
Content-Type: application/json

{}


### 11. 먹이를 테이블에 직접 수정 (앱에서 값 조작 시도)
# 기대: 200 이지만 [] (RLS 때문에 한 줄도 바뀌지 않음)
PATCH {{url}}/rest/v1/pets?user_id=not.is.null
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "food": 9999 }


### 12. 다른 사람 정보 조회 시도
# 기대: 200, 내 행 1개만 보임 (다른 사용자의 UUID·닉네임은 안 보임)
GET {{url}}/rest/v1/users?select=*
apikey: {{key}}
Authorization: Bearer {{token}}


### 13. 이미 등록한 사용자가 다시 등록
# 기대: 409, ALREADY_REGISTERED
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_nickname": "새닉네임" }


### 14-1. 두 번째 익명 사용자 만들기
# 기대: 200
# @name signup2
POST {{url}}/auth/v1/signup
apikey: {{key}}
Content-Type: application/json

{}


### 14-2. 닉네임 등록 전에 수집 기록 저장
# 기대: 403, NOT_REGISTERED
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 07",
  "p_temperature": 21.5,
  "p_humidity": 55.0,
  "p_aqi": null,
  "p_tvoc": null,
  "p_co2": null,
  "p_rssi": -70,
  "p_measured_at": "{{$datetime iso8601}}",
  "p_public_server_id": null,
  "p_is_shadow_area": false,
  "p_is_test": true
}


### 14-3. 4번에서 등록한 닉네임으로 등록 시도
# 기대: 409, NICKNAME_TAKEN → 앱에서 '이미 사용 중인 닉네임' 표시
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{ "p_nickname": "{{profile.response.body.$[0].nickname}}" }


### 14-4. 너무 짧은 닉네임
# 기대: 400, NICKNAME_INVALID
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{ "p_nickname": "a" }


### 14-5. 두 번째 사용자 정상 등록 (15번 준비)
# 기대: 200
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{ "p_nickname": "user{{$randomInt 1000 9999}}" }


### 15. 다른 사용자의 수집 기록 재전송
# 기대: 403, RECORD_OF_OTHER_USER
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token2}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 07",
  "p_temperature": 21.5,
  "p_humidity": 55.0,
  "p_aqi": 1,
  "p_tvoc": 100,
  "p_co2": 650,
  "p_rssi": -70,
  "p_measured_at": "{{collect.response.body.$.record.measured_at}}",
  "p_public_server_id": "{{collect.response.body.$.record.public_server_id}}",
  "p_is_shadow_area": false,
  "p_is_test": true
}


### 16. 범위를 벗어난 값 (습도 101%)
# 기대: 400, INVALID_VALUE
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 07",
  "p_temperature": 21.5,
  "p_humidity": 101,
  "p_aqi": null,
  "p_tvoc": null,
  "p_co2": null,
  "p_rssi": -70,
  "p_measured_at": "{{$datetime iso8601}}",
  "p_public_server_id": null,
  "p_is_shadow_area": false,
  "p_is_test": true
}


### 17. 실제 모드인데 공용 서버 id 없음
# 기대: 400, MISSING_SERVER_ID
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 07",
  "p_temperature": 21.5,
  "p_humidity": 55.0,
  "p_aqi": null,
  "p_tvoc": null,
  "p_co2": null,
  "p_rssi": -70,
  "p_measured_at": "{{$datetime iso8601}}",
  "p_public_server_id": null,
  "p_is_shadow_area": false,
  "p_is_test": false
}


### ---------------------------------------------------------------------
### [보상] 1번 사용자(token)로 진행. 실제 모드 기록을 가짜 id(test-…)로 만든다.
###   ※ 운영 데이터와 섞이므로 테스트 사용자는 나중에 지운다.
### ---------------------------------------------------------------------

### R1. 첫 실제 수집 (sensor 15)
# 기대: rewards = [{ food 2, reason "first_collection" }], food 2
# @name rcollect
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 15", "p_temperature": 20.0, "p_humidity": 50.0,
  "p_aqi": null, "p_tvoc": null, "p_co2": null, "p_rssi": -70,
  "p_measured_at": "{{$datetime iso8601}}",
  "p_public_server_id": "test-{{$guid}}",
  "p_is_shadow_area": false, "p_is_test": false
}


### R2. R1 재전송
# 기대: record.id 가 R1과 같고 rewards [] (두 번 지급되지 않음)
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 15", "p_temperature": 20.0, "p_humidity": 50.0,
  "p_aqi": null, "p_tvoc": null, "p_co2": null, "p_rssi": -70,
  "p_measured_at": "{{rcollect.response.body.$.record.measured_at}}",
  "p_public_server_id": "{{rcollect.response.body.$.record.public_server_id}}",
  "p_is_shadow_area": false, "p_is_test": false
}


### R3. 같은 센서 일반 수집 → 이 요청을 4번 누른다
# 기대: 1~3번째 rewards [] (같은 센서라 첫 수집 아님)
#       4번째(누적 5회) rewards = [{ food 1, reason "collection" }]
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 15", "p_temperature": 20.0, "p_humidity": 50.0,
  "p_aqi": null, "p_tvoc": null, "p_co2": null, "p_rssi": -70,
  "p_measured_at": "{{$datetime iso8601}}",
  "p_public_server_id": "test-{{$guid}}",
  "p_is_shadow_area": false, "p_is_test": false
}


### R4. 음영지역 수집 (sensor 31) → 이 요청을 5번 누른다
# 기대: 1번째 rewards = [{ food 2, "first_collection" }]
#       5번째 rewards = [{ food 2, "shadow_collection" }]
#       일반 수집 횟수는 늘지 않음
POST {{url}}/rest/v1/rpc/add_collection_record
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "p_sensor_name": "sensor 31", "p_temperature": 20.0, "p_humidity": 50.0,
  "p_aqi": null, "p_tvoc": null, "p_co2": null, "p_rssi": -70,
  "p_measured_at": "{{$datetime iso8601}}",
  "p_public_server_id": "test-{{$guid}}",
  "p_is_shadow_area": true, "p_is_test": false
}


### R5. 내 수집 현황 (FR-05-06)
# 기대: collection_count 5, shadow_collection_count 5,
#       next_collection_reward_in 5, next_shadow_reward_in 5,
#       first_sensors ["sensor 15", "sensor 31"]
POST {{url}}/rest/v1/rpc/get_my_collection_stats
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}


### R6. 내 보상 이력
# 기대: 4건 (first_collection 2, collection 1, first_collection 2, shadow_collection 2)
#       → 5번 get_my_profile 의 food 는 7
GET {{url}}/rest/v1/reward_history?select=reason,food,collection_record_id,created_at&order=id
apikey: {{key}}
Authorization: Bearer {{token}}


### ---------------------------------------------------------------------
### [먹이 주기] R1~R6 바로 다음에, 같은 사용자(token)로 이어서 한다. (시작 food 7)
### ---------------------------------------------------------------------

### F1. 먹이 주기 (1번 누름)
# 기대: level 1, feed_in_level 1, feed_needed 2, food 6, leveled_up false
POST {{url}}/rest/v1/rpc/feed_pet
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}" }


### F2. 먹이 주기 → 레벨업 (1번 누름)
# 기대: level 2, feed_in_level 0, feed_needed 3, food 5, leveled_up true
# @name feed2
POST {{url}}/rest/v1/rpc/feed_pet
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}" }


### F3. F2 재전송 (같은 요청 ID)
# 기대: F2와 완전히 같은 응답, food 5 그대로 (먹이가 또 줄지 않음)
POST {{url}}/rest/v1/rpc/feed_pet
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_request_id": "{{feed2.request.body.$.p_request_id}}" }


### F4. 먹이 주기 → 이 요청을 5번 누른다
# 기대: 3번째에 level 3, stage "baby", evolved true (진화!), food 2
#       5번째에 food 0, feed_in_level 2
POST {{url}}/rest/v1/rpc/feed_pet
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}" }


### F5. 먹이 0개에서 먹이 주기
# 기대: 400, NOT_ENOUGH_FOOD
POST {{url}}/rest/v1/rpc/feed_pet
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}" }
