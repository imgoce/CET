### C10. 테스트 모드 (DC-7)
# 기대: credited false, grants [], 운영 먹이·카운터 그대로
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_test": true, "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}", "windowId": "{{$guid}}",
  "windowStartAt": "2026-11-25T03:01:00Z", "candidateSensorNo": 7,
  "measurement": { "sensorNo": 7, "sensorMac": "88:A2:9E:9B:5F:09",
    "measuredAt": "2026-11-25T03:01:00Z", "collectedAt": "2026-11-25T03:01:01Z", "rssiDbm": -55,
    "temperatureC": 29.5, "humidityRh": 55, "co2Ppm": null, "eco2Ppm": 710, "aqi": 2, "tvocPpb": 200 },
  "publicRoute": "UPLOADED", "publicId": 129 } }


### C11. 음영지역 조회 (getShadowSites)
# 기대: sites 5곳 (측정 수 오름차순·번호순), updatedAt = 마지막 측정 저장 시각
POST {{url}}/rest/v1/rpc/get_shadow_sites
apikey: {{key}}
Content-Type: application/json

{}
