# 기대: credited true, isShadowBefore true, grants [FIRST_SENSOR_DAY 2], shadowRemainder 1
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}", "windowId": "{{$guid}}",
