### =====================================================================
### CET 팀 DB API 테스트 · 계약서 v1.2 (VS Code 확장: REST Client by Huachao Mao)
###
### 준비: 같은 폴더의 .env.example 을 .env 로 복사해 URL·키를 채운다.
### 사용: 각 요청 위의 "Send Request"를 위에서부터 순서대로 누른다.
###
### - 로그인 토큰 없이 Publishable key 만으로 호출한다 (계약서 §08, 닉네임 접속).
### - 실패 응답: { "code": "PTxxx", "message": "<오류 코드>", "details": "<설명>" }
### - 테스트 사용자 정리: SQL Editor 에서  delete from public.users where nickname like 't%';
### =====================================================================

@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_PUBLISHABLE_KEY}}

@userId   = {{reg.response.body.$.userId}}
@nickname = {{reg.request.body.$.p_nickname}}


### ---------------------------------------------------------------------
### [2단계] 닉네임 등록·접속·사용자 상태 (§08)
### ---------------------------------------------------------------------

### U1. 신규 등록 (US-1, US-1-3)
# 기대: 200, userId 발급, pet = { level 1, progress 0, foodBalance 0, stage "EGG",
#       drawCount 0, nextDrawCost 24, ownedCostumes [], equippedCostume null }
# @name reg
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}", "p_nickname": "t{{$randomInt 100000 999999}}" }


### U2. 같은 요청 재전송 (같은 requestId·닉네임)
# 기대: 200, U1과 같은 userId (사용자가 새로 생기지 않음)
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Content-Type: application/json

{ "p_request_id": "{{reg.request.body.$.p_request_id}}", "p_nickname": "{{nickname}}" }


### U3. 같은 requestId 에 다른 닉네임
# 기대: 409, ID_CONFLICT
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Content-Type: application/json

{ "p_request_id": "{{reg.request.body.$.p_request_id}}", "p_nickname": "other1" }


### U4. 다른 기기에서 같은 닉네임으로 신규 등록 (새 requestId)
# 기대: 409, NICKNAME_TAKEN (US-1-1)
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}", "p_nickname": "{{nickname}}" }


### U5. 1자 닉네임 (양끝 공백은 제거 후 검사)
# 기대: 400, INVALID_INPUT
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}", "p_nickname": "  a  " }


### U6. 11자 닉네임
# 기대: 400, INVALID_INPUT
POST {{url}}/rest/v1/rpc/register_user
apikey: {{key}}
Content-Type: application/json

{ "p_request_id": "{{$guid}}", "p_nickname": "abcdefghijk" }


### U7. 닉네임으로 접속 (다른 폰, US-2·US-2-1). 앞뒤 공백이 있어도 같은 닉네임
# 기대: 200, U1과 같은 userId·펫
POST {{url}}/rest/v1/rpc/login_by_nickname
apikey: {{key}}
Content-Type: application/json

{ "p_nickname": "  {{nickname}} " }


### U8. 없는 닉네임으로 접속
# 기대: 404, NICKNAME_NOT_FOUND (새 사용자를 만들지 않음)
POST {{url}}/rest/v1/rpc/login_by_nickname
apikey: {{key}}
Content-Type: application/json

{ "p_nickname": "없는닉네임" }


### U9. 저장된 userId 로 자동 접속 (US-2-2)
# 기대: 200, U1과 같은 UserState
POST {{url}}/rest/v1/rpc/get_user_state
apikey: {{key}}
Content-Type: application/json

{ "p_user_id": "{{userId}}" }


### U10. 모르는 userId
# 기대: 404, USER_NOT_FOUND
POST {{url}}/rest/v1/rpc/get_user_state
apikey: {{key}}
Content-Type: application/json

{ "p_user_id": "{{$guid}}" }


### ---------------------------------------------------------------------
### [보안] 표에 직접 접근 (모두 실패해야 정상)
### ---------------------------------------------------------------------

### X1. 사용자 표 직접 조회
# 기대: 401 permission denied (닉네임·userId 목록이 보이면 안 됨)
GET {{url}}/rest/v1/users?select=*
apikey: {{key}}


### X2. 먹이 직접 수정
# 기대: 401 permission denied
PATCH {{url}}/rest/v1/pets?user_id=eq.{{userId}}
apikey: {{key}}
Content-Type: application/json

{ "food_balance": 9999 }


### ---------------------------------------------------------------------
### [3단계] 수집 저장 commit_collection (§06·07·13)
###   U1 에서 만든 사용자로 이어서 한다. 기준 시각 T = 2026-11-25T03:00:00Z (KST 12:00)
###   음영 결과(isShadowBefore)는 dev_reset.sql 직후 처음 실행할 때 기준이다.
### ---------------------------------------------------------------------

### C1. 첫 기여: 구간 W1 [T, T+10s), 후보 7번 = 측정 7번
# 기대: credited true, isShadowBefore false, grants [FIRST_SENSOR_DAY 2],
#       foodBalance 2, normalRemainder 1, replayed false
# @name c1
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}", "windowId": "{{$guid}}",
  "windowStartAt": "2026-11-25T03:00:00Z", "candidateSensorNo": 7,
  "measurement": { "sensorNo": 7, "sensorMac": "88:A2:9E:9B:5F:09",
    "measuredAt": "2026-11-25T03:00:00Z", "collectedAt": "2026-11-25T03:00:03Z", "rssiDbm": -55,
    "temperatureC": 29.5, "humidityRh": 55, "co2Ppm": null, "eco2Ppm": 710, "aqi": 2, "tvocPpb": 200 },
  "publicRoute": "UPLOADED", "publicId": 123 } }


### C2. C1 재전송 (DB 타임아웃 후 같은 요청)
# 기대: C1과 같은 결과 + replayed true. 먹이가 다시 늘지 않음
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{c1.request.body.$.p_input.collectionId}}", "userId": "{{userId}}",
  "windowId": "{{c1.request.body.$.p_input.windowId}}",
  "windowStartAt": "2026-11-25T03:00:00Z", "candidateSensorNo": 7,
  "measurement": { "sensorNo": 7, "sensorMac": "88:A2:9E:9B:5F:09",
    "measuredAt": "2026-11-25T03:00:00Z", "collectedAt": "2026-11-25T03:00:03Z", "rssiDbm": -55,
    "temperatureC": 29.5, "humidityRh": 55, "co2Ppm": null, "eco2Ppm": 710, "aqi": 2, "tvocPpb": 200 },
  "publicRoute": "UPLOADED", "publicId": 123 } }


### C3. 같은 collectionId 에 다른 내용 (RSSI 만 다름)
# 기대: 409, ID_CONFLICT
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{c1.request.body.$.p_input.collectionId}}", "userId": "{{userId}}",
  "windowId": "{{c1.request.body.$.p_input.windowId}}",
  "windowStartAt": "2026-11-25T03:00:00Z", "candidateSensorNo": 7,
  "measurement": { "sensorNo": 7, "sensorMac": "88:A2:9E:9B:5F:09",
    "measuredAt": "2026-11-25T03:00:00Z", "collectedAt": "2026-11-25T03:00:03Z", "rssiDbm": -60,
    "temperatureC": 29.5, "humidityRh": 55, "co2Ppm": null, "eco2Ppm": 710, "aqi": 2, "tvocPpb": 200 },
  "publicRoute": "UPLOADED", "publicId": 123 } }


### C4. 같은 구간 W1 의 다른 센서 15번 (후보가 아님)
# 기대: credited false, grants [], measurementAdded true (환경 표본은 저장)
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}",
  "windowId": "{{c1.request.body.$.p_input.windowId}}",
  "windowStartAt": "2026-11-25T03:00:00Z", "candidateSensorNo": 7,
  "measurement": { "sensorNo": 15, "sensorMac": "88:A2:9E:9B:5F:15",
    "measuredAt": "2026-11-25T03:00:01Z", "collectedAt": "2026-11-25T03:00:04Z", "rssiDbm": -72,
    "temperatureC": 21.0, "humidityRh": 50, "co2Ppm": null, "eco2Ppm": 650, "aqi": 1, "tvocPpb": 100 },
  "publicRoute": "UPLOADED", "publicId": 124 } }


### C5. 다른 폰의 겹치는 구간 [T+5s, T+15s)
# 기대: credited false (W1 과 겹침), grants []
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}", "windowId": "{{$guid}}",
  "windowStartAt": "2026-11-25T03:00:05Z", "candidateSensorNo": 15,
  "measurement": { "sensorNo": 15, "sensorMac": "88:A2:9E:9B:5F:15",
    "measuredAt": "2026-11-25T03:00:05Z", "collectedAt": "2026-11-25T03:00:06Z", "rssiDbm": -60,
    "temperatureC": 21.0, "humidityRh": 50, "co2Ppm": null, "eco2Ppm": 650, "aqi": 1, "tvocPpb": 100 },
  "publicRoute": "UPLOADED", "publicId": 125 } }


### C6. 맞닿은 구간 [T+10s, T+20s) 은 겹치지 않는다
# 기대: credited true, grants [FIRST_SENSOR_DAY 2] (15번 오늘 첫 기여), foodBalance 4, normalRemainder 2
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}", "windowId": "{{$guid}}",
  "windowStartAt": "2026-11-25T03:00:10Z", "candidateSensorNo": 15,
  "measurement": { "sensorNo": 15, "sensorMac": "88:A2:9E:9B:5F:15",
    "measuredAt": "2026-11-25T03:00:10Z", "collectedAt": "2026-11-25T03:00:11Z", "rssiDbm": -60,
    "temperatureC": 21.0, "humidityRh": 50, "co2Ppm": null, "eco2Ppm": 650, "aqi": 1, "tvocPpb": 100 },
  "publicRoute": "UPLOADED", "publicId": 126 } }


### C7. 31번 (온습도 고장): 공용 전송 생략, 원시 온습도 0
# 기대: credited true, grants [FIRST_SENSOR_DAY 2], 저장된 온습도는 null
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}", "windowId": "{{$guid}}",
  "windowStartAt": "2026-11-25T03:00:20Z", "candidateSensorNo": 31,
  "measurement": { "sensorNo": 31, "sensorMac": "B8:27:EB:D3:40:06",
    "measuredAt": "2026-11-25T03:00:20Z", "collectedAt": "2026-11-25T03:00:23Z", "rssiDbm": -53,
    "temperatureC": 0, "humidityRh": 0, "co2Ppm": null, "eco2Ppm": 715, "aqi": 2, "tvocPpb": 200 },
  "publicRoute": "TEMP_UNAVAILABLE", "publicId": null } }


### C8. 음영지역 센서 1번 (연구실, 처음엔 01~05가 음영)
# 기대: credited true, isShadowBefore true, grants [FIRST_SENSOR_DAY 2], shadowRemainder 1
POST {{url}}/rest/v1/rpc/commit_collection
apikey: {{key}}
Content-Type: application/json

{ "p_input": {
  "collectionId": "{{$guid}}", "userId": "{{userId}}", "windowId": "{{$guid}}",
  "windowStartAt": "2026-11-25T03:00:30Z", "candidateSensorNo": 1,
  "measurement": { "sensorNo": 1, "sensorMac": "B8:27:EB:00:00:01",
    "measuredAt": "2026-11-25T03:00:30Z", "collectedAt": "2026-11-25T03:00:31Z", "rssiDbm": -60,
